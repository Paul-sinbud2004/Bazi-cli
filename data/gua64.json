  "wuxing": "土",
  "xiantian_upper": 7,
  "xiantian_lower": 2,
  "guaci": "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",
  "yaoci": [
   {
    "name": "初九",
    "text": "已事遄往，无咎；酌损之。"
   },
   {
    "name": "九二",
    "text": "利贞，征凶；弗损益之。"
   },
   {
    "name": "六三",
    "text": "三人行，则损一人；一人行，则得其友。"
   },
   {
    "name": "六四",
    "text": "损其疾，使遄有喜，无咎。"
   },
   {
    "name": "六五",
    "text": "或益之十朋之龟，弗克违，元吉。"
   },
   {
    "name": "上九",
    "text": "弗损益之，无咎。贞吉，利有攸往，得臣无家。"
   }
  ]
 },
 {
