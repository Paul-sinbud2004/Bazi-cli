  "guaci": "利艰贞。",
  "yaoci": [
   {
    "name": "初九",
    "text": "明夷于飞，垂其翼；君子于行，三日不食。有攸往，主人有言。"
   },
   {
    "name": "六二",
    "text": "明夷，夷于左股，用拯马壮，吉。"
   },
   {
    "name": "九三",
    "text": "明夷于南狩，得其大首。不可疾贞。"
   },
   {
    "name": "六四",
    "text": "入于左腹，获明夷之心，于出门庭。"
   },
   {
    "name": "六五",
    "text": "箕子之明夷，利贞。"
   },
   {
    "name": "上六",
    "text": "不明晦，初登于天，后入于地。"
   }
  ]
 },
 {
