  "wuxing": "水",
  "xiantian_upper": 6,
  "xiantian_lower": 7,
  "guaci": "利西南，不利东北；利见大人，贞吉。",
  "yaoci": [
   {
    "name": "初六",
    "text": "往蹇，来誉。"
   },
   {
    "name": "六二",
    "text": "王臣蹇蹇，匪躬之故。"
   },
   {
    "name": "九三",
    "text": "往蹇，来反。"
   },
   {
    "name": "六四",
    "text": "往蹇，来连。"
   },
   {
    "name": "九五",
    "text": "大蹇，朋来。"
   },
   {
    "name": "上六",
    "text": "往蹇，来硕；吉，利见大人。"
   }
  ]
 },
 {
