  "xiantian_upper": 5,
  "xiantian_lower": 4,
  "guaci": "利有攸往，利涉大川。",
  "yaoci": [
   {
    "name": "初九",
    "text": "利用为大作，元吉，无咎。"
   },
   {
    "name": "六二",
    "text": "或益之十朋之龟，弗克违。永贞吉；王用享于帝，吉。"
   },
   {
    "name": "六三",
    "text": "益之用凶事，无咎；有孚中行，告公用圭。"
   },
   {
    "name": "六四",
    "text": "中行，告公从，利用为依迁国。"
   },
   {
    "name": "九五",
    "text": "有孚惠心，勿问元吉。有孚惠我德。"
   },
   {
    "name": "上九",
    "text": "莫益之，或击之，立心勿恒，凶。"
   }
  ]
 },
 {
