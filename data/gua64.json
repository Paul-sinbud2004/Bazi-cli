  "xiantian_lower": 7,
  "guaci": "亨，利贞；可小事，不可大事；飞鸟遗之音，不宜上，宜下，大吉。",
  "yaoci": [
   {
    "name": "初六",
    "text": "飞鸟以凶。"
   },
   {
    "name": "六二",
    "text": "过其祖，遇其妣；不及其君，遇其臣，无咎。"
   },
   {
    "name": "九三",
    "text": "弗过防之，从或戕之，凶。"
   },
   {
    "name": "九四",
    "text": "无咎，弗过遇之；往厉必戒，勿用永贞。"
   },
   {
    "name": "六五",
    "text": "密云不雨，自我西郊；公弋取彼在穴。"
   },
   {
    "name": "上六",
    "text": "弗遇过之；飞鸟离之，凶，是谓灾眚。"
   }
  ]
 },
