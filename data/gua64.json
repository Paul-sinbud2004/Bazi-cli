  "xiantian_upper": 5,
  "xiantian_lower": 3,
  "guaci": "利女贞。",
  "yaoci": [
   {
    "name": "初九",
    "text": "闲有家，悔亡。"
   },
   {
    "name": "六二",
    "text": "无攸遂，在中馈，贞吉。"
   },
   {
    "name": "九三",
    "text": "家人嗃嗃，悔厉，吉；妇子嘻嘻，终吝。"
   },
   {
    "name": "六四",
    "text": "富家，大吉。"
   },
   {
    "name": "九五",
    "text": "王假有家，勿恤，吉。"
   },
   {
    "name": "上九",
    "text": "有孚，威如，终吉。"
   }
  ]
 },
 {
