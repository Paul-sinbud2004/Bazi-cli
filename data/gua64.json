  "wuxing": "木",
  "xiantian_upper": 4,
  "xiantian_lower": 6,
  "guaci": "利西南。无所往，其来复吉。有攸往，夙吉。",
  "yaoci": [
   {
    "name": "初六",
    "text": "无咎。"
   },
   {
    "name": "九二",
    "text": "田获三狐，得黄矢；贞吉。"
   },
   {
    "name": "六三",
    "text": "负且乘，致寇至，贞吝。"
   },
   {
    "name": "九四",
    "text": "解而拇，朋至斯孚。"
   },
   {
    "name": "六五",
    "text": "君子维有解，吉，有孚于小人。"
   },
   {
    "name": "上六",
    "text": "公用射隼于高墉之上，获之，无不利。"
   }
  ]
 },
 {
