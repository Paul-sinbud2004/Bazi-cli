  "wuxing": "金",
  "xiantian_upper": 2,
  "xiantian_lower": 1,
  "guaci": "扬于王庭，孚号有厉；告自邑，不利即戎，利有攸往。",
  "yaoci": [
   {
    "name": "初九",
    "text": "壮于前趾，往不胜为咎。"
   },
   {
    "name": "九二",
    "text": "惕号，莫夜有戎，勿恤。"
   },
   {
    "name": "九三",
    "text": "壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠无咎。"
   },
   {
    "name": "九四",
    "text": "臀无肤，其行次且；牵羊悔亡，闻言不信。"
   },
   {
    "name": "九五",
    "text": "苋陆夬夬，中行无咎。"
   },
   {
    "name": "上六",
    "text": "无号，终有凶。"
   }
  ]
 },
