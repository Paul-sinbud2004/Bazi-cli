  "xiantian_upper": 5,
  "xiantian_lower": 7,
  "guaci": "女归吉，利贞。",
  "yaoci": [
   {
    "name": "初六",
    "text": "鸿渐于干；小子厉，有言，无咎。"
   },
   {
    "name": "六二",
    "text": "鸿渐于磐，饮食衎衎，吉。"
   },
   {
    "name": "九三",
    "text": "鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。"
   },
   {
    "name": "六四",
    "text": "鸿渐于木，或得其桷，无咎。"
   },
   {
    "name": "九五",
    "text": "鸿渐于陵，妇三岁不孕；终莫之胜，吉。"
   },
   {
    "name": "上九",
    "text": "鸿渐于陆，其羽可用为仪，吉。"
   }
  ]
 },
