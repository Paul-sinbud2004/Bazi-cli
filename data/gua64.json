   1
  ],
  "lower": "乾",
  "upper": "乾",
  "lower_symbol": "☰",
  "upper_symbol": "☰",
  "wuxing": "金",
  "xiantian_upper": 1,
  "xiantian_lower": 1,
  "guaci": "元亨利贞。",
  "yaoci": [
   {
    "name": "初九",
    "text": "潜龙，勿用。"
   },
   {
    "name": "九二",
    "text": "见龙在田，利见大人。"
   },
   {
    "name": "九三",
    "text": "君子终日干干，夕惕若，厉无咎。"
   },
   {
    "name": "九四",
    "text": "或跃在渊，无咎。"
   },
   {
    "name": "九五",
    "text": "飞龙在天，利见大人。"
   },
   {
    "name": "上九",
    "text": "亢龙有悔。"
   },
   {
    "name": "用九",
    "text": "见群龙无首，吉。"
   }
  ]
 },
 {
  "id": 2,
  "name": "坤",
  "symbol": "䷁",
  "array": [
   0,
   0,
   0,
   0,
   0,
   0
  ],
  "lower": "坤",
  "upper": "坤",
  "lower_symbol": "☷",
  "upper_symbol": "☷",
  "wuxing": "土",
  "xiantian_upper": 8,
  "xiantian_lower": 8,
  "guaci": "元亨，利牝马之贞。君子有攸往，先迷，后得主，利。西南得朋，东北丧朋。安贞吉。",
  "yaoci": [
   {
    "name": "初六",
    "text": "履霜，坚冰至。"
   },
   {
    "name": "六二",
    "text": "直方大，不习无不利。"
   },
   {
    "name": "六三",
    "text": "含章可贞；或从王事，无成有终。"
   },
   {
    "name": "六四",
    "text": "括囊，无咎无誉。"
   },
   {
    "name": "六五",
    "text": "黄裳，元吉。"
   },
   {
    "name": "上六",
    "text": "龙战于野，其血玄黄。"
   },
   {
    "name": "用六",
    "text": "利永贞。"
   }
  ]
 },
 {
  "id": 3,
  "name": "屯",
  "symbol": "䷂",
  "array": [
   1,
   0,
   0,
   0,
   1,
   0
  ],
  "lower": "震",
  "upper": "坎",
  "lower_symbol": "☳",
  "upper_symbol": "☵",
  "wuxing": "水",
  "xiantian_upper": 6,
  "xiantian_lower": 4,
  "guaci": "元亨，利贞；勿用有攸往，利建侯。",
  "yaoci": [
   {
    "name": "初九",
    "text": "磐桓；利居贞，利建侯。"
   },
   {
    "name": "六二",
    "text": "屯如，邅如，乘马班如。匪寇婚媾。女子贞不字，十年乃字。"
   },
   {
    "name": "六三",
    "text": "即鹿无虞，惟入于林中，君子几，不如舍，往吝。"
   },
   {
    "name": "六四",
    "text": "乘马班如，求婚媾，往吉，无不利。"
   },
   {
    "name": "九五",
    "text": "屯其膏，小贞吉，大贞凶。"
   },
   {
    "name": "上六",
    "text": "乘马班如，泣血涟如。"
   }
  ]
 },
 {
  "id": 4,
  "name": "蒙",
  "symbol": "䷃",
  "array": [
   0,
   1,
   0,
   0,
   0,
   1
  ],
  "lower": "坎",
  "upper": "艮",
  "lower_symbol": "☵",
  "upper_symbol": "☶",
  "wuxing": "土",
  "xiantian_upper": 7,
  "xiantian_lower": 6,
  "guaci": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
  "yaoci": [
   {
    "name": "初六",
    "text": "发蒙，利用刑人，用说桎梏；以往吝。"
   },
   {
    "name": "九二",
    "text": "包蒙，吉。纳妇，吉；子克家。"
   },
   {
    "name": "六三",
    "text": "勿用取女，见金夫，不有躬，无攸利。"
   },
   {
    "name": "六四",
    "text": "困蒙，吝。"
   },
   {
    "name": "六五",
    "text": "童蒙，吉。"
   },
   {
    "name": "上九",
    "text": "击蒙；不利为寇，利御寇。"
   }
  ]
 },
 {
  "id": 5,
  "name": "需",
  "symbol": "䷄",
  "array": [
   1,
   1,
   1,
   0,
   1,
   0
  ],
  "lower": "乾",
  "upper": "坎",
  "lower_symbol": "☰",
  "upper_symbol": "☵",
  "wuxing": "水",
  "xiantian_upper": 6,
  "xiantian_lower": 1,
  "guaci": "有孚，光亨，贞吉，利涉大川。",
  "yaoci": [
   {
    "name": "初九",
    "text": "需于郊，利用恒，无咎。"
   },
   {
    "name": "九二",
    "text": "需于沙，小有言；终吉。"
   },
   {
    "name": "九三",
    "text": "需于泥，致寇至。"
   },
   {
    "name": "六四",
    "text": "需于血，出自穴。"
   },
   {
    "name": "九五",
    "text": "需于酒食，贞吉。"
   },
   {
    "name": "上六",
    "text": "入于穴，有不速之客三人来；敬之，终吉。"
   }
  ]
 },
 {
  "id": 6,
  "name": "讼",
  "symbol": "䷅",
  "array": [
   0,
   1,
   0,
   1,
   1,
   1
  ],
  "lower": "坎",
  "upper": "乾",
  "lower_symbol": "☵",
  "upper_symbol": "☰",
  "wuxing": "金",
  "xiantian_upper": 1,
  "xiantian_lower": 6,
  "guaci": "有孚，窒惕，中吉；终凶。利见大人，不利涉大川。",
  "yaoci": [
   {
    "name": "初六",
    "text": "不永所事，小有言，终吉。"
   },
   {
    "name": "九二",
    "text": "不克讼，归而逋，其邑人三百户，无眚。"
   },
   {
    "name": "六三",
    "text": "食旧德，贞厉，终吉；或从王事，无成。"
   },
   {
    "name": "九四",
    "text": "不克讼；复即命，渝，安贞，吉。"
   },
   {
    "name": "九五",
    "text": "讼，元吉。"
   },
   {
    "name": "上九",
    "text": "或锡之鞶带，终朝三褫之。"
   }
  ]
 },
 {
  "id": 7,
  "name": "师",
  "symbol": "䷆",
  "array": [
   0,
   1,
   0,
   0,
   0,
   0
  ],
  "lower": "坎",
  "upper": "坤",
  "lower_symbol": "☵",
  "upper_symbol": "☷",
  "wuxing": "土",
  "xiantian_upper": 8,
  "xiantian_lower": 6,
  "guaci": "贞，丈人吉，无咎。",
  "yaoci": [
   {
    "name": "初六",
    "text": "师出以律，否臧凶。"
   },
   {
    "name": "九二",
    "text": "在师中吉，无咎；王三锡命。"
   },
   {
    "name": "六三",
    "text": "师或舆尸，凶。"
   },
   {
    "name": "六四",
    "text": "师左次，无咎。"
   },
   {
    "name": "六五",
    "text": "田有禽，利执言，无咎；长子帅师，弟子舆尸，贞凶。"
   },
   {
    "name": "上六",
    "text": "大君有命，开国承家，小人勿用。"
   }
  ]
 },
 {
  "id": 8,
  "name": "比",
  "symbol": "䷇",
  "array": [
   0,
   0,
   0,
   0,
   1,
   0
  ],
  "lower": "坤",
  "upper": "坎",
  "lower_symbol": "☷",
  "upper_symbol": "☵",
  "wuxing": "水",
  "xiantian_upper": 6,
  "xiantian_lower": 8,
  "guaci": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
  "yaoci": [
   {
    "name": "初六",
    "text": "有孚比之，无咎；有孚盈缶，终来有它，吉。"
   },
   {
    "name": "六二",
    "text": "比之自内，贞吉。"
   },
   {
    "name": "六三",
    "text": "比之匪人。"
   },
   {
    "name": "六四",
    "text": "外比之，贞吉。"
   },
   {
    "name": "九五",
    "text": "显比；王用三驱，失前禽。邑人不诫，吉。"
   },
   {
    "name": "上六",
    "text": "比之无首，凶。"
   }
  ]
 },
 {
  "id": 9,
  "name": "小畜",
  "symbol": "䷈",
  "array": [
   1,
   1,
   1,
   0,
   1,
   1
  ],
  "lower": "乾",
  "upper": "巽",
  "lower_symbol": "☰",
  "upper_symbol": "☴",
  "wuxing": "木",
  "xiantian_upper": 5,
  "xiantian_lower": 1,
  "guaci": "亨。密云不雨，自我西郊。",
  "yaoci": [
   {
    "name": "初九",
    "text": "复自道，何其咎？吉。"
   },
   {
    "name": "九二",
    "text": "牵复，吉。"
   },
   {
    "name": "九三",
    "text": "舆说辐，夫妻反目。"
   },
   {
    "name": "六四",
    "text": "有孚，血去惕出，无咎。"
   },
   {
    "name": "九五",
    "text": "有孚挛如，富以其邻。"
   },
   {
    "name": "上九",
    "text": "既雨既处，尚德载；妇贞厉，月几望；君子征凶。"
   }
  ]
 },
 {
  "id": 10,
  "name": "履",
  "symbol": "䷉",
  "array": [
   1,
   1,
   0,
   1,
   1,
   1
  ],
  "lower": "兑",
  "upper": "乾",
  "lower_symbol": "☱",
  "upper_symbol": "☰",
  "wuxing": "金",
  "xiantian_upper": 1,
  "xiantian_lower": 2,
  "guaci": "履虎尾，不咥人，亨。",
  "yaoci": [
   {
    "name": "初九",
    "text": "素履，往，无咎。"
   },
   {
    "name": "九二",
    "text": "履道坦坦，幽人贞吉。"
   },
   {
    "name": "六三",
    "text": "眇能视，跛能履，履虎尾，咥人，凶；武人为于大君。"
   },
   {
    "name": "九四",
    "text": "履虎尾，愬愬，终吉。"
   },
   {
    "name": "九五",
    "text": "夬履，贞厉。"
   },
   {
    "name": "上九",
    "text": "视履考祥，其旋元吉。"
   }
  ]
 },
 {
  "id": 11,
  "name": "泰",
  "symbol": "䷊",
  "array": [
   1,
   1,
   1,
   0,
   0,
   0
  ],
  "lower": "乾",
  "upper": "坤",
  "lower_symbol": "☰",
  "upper_symbol": "☷",
  "wuxing": "土",
  "xiantian_upper": 8,
  "xiantian_lower": 1,
  "guaci": "小往大来，吉，亨。",
  "yaoci": [
   {
    "name": "初九",
    "text": "拔茅茹，以其汇，征吉。"
   },
   {
    "name": "九二",
    "text": "包荒，用冯河，不遐遗；朋亡，得尚于中行。"
   },
   {
    "name": "九三",
    "text": "无平不陂，无往不复；艰贞无咎，勿恤其孚，于食有福。"
   },
   {
    "name": "六四",
    "text": "翩翩，不富，以其邻，不戒以孚。"
   },
   {
    "name": "六五",
    "text": "帝乙归妹，以祉元吉。"
   },
   {
    "name": "上六",
    "text": "城复于隍，勿用师，自邑告命，贞吝。"
   }
  ]
 },
 {
  "id": 12,
  "name": "否",
  "symbol": "䷋",
  "array": [
   0,
   0,
   0,
   1,
   1,
   1
  ],
  "lower": "坤",
  "upper": "乾",
  "lower_symbol": "☷",
  "upper_symbol": "☰",
  "wuxing": "金",
  "xiantian_upper": 1,
  "xiantian_lower": 8,
  "guaci": "否之匪人，不利君子贞，大往小来。",
  "yaoci": [
   {
    "name": "初六",
    "text": "拔茅茹，以其汇，贞吉，亨。"
   },
   {
    "name": "六二",
    "text": "包承，小人吉。大人否，亨。"
   },
   {
    "name": "六三",
    "text": "包羞。"
   },
   {
    "name": "九四",
    "text": "有命无咎，畴离祉。"
   },
   {
    "name": "九五",
    "text": "休否，大人吉；其亡其亡，系于苞桑。"
   },
   {
    "name": "上九",
    "text": "倾否，先否后喜。"
   }
  ]
 },
 {
  "id": 13,
  "name": "同人",
  "symbol": "䷌",
  "array": [
   1,
   0,
   1,
   1,
   1,
   1
  ],
  "lower": "离",
  "upper": "乾",
  "lower_symbol": "☲",
  "upper_symbol": "☰",
  "wuxing": "金",
  "xiantian_upper": 1,
  "xiantian_lower": 3,
  "guaci": "同人于野，亨。利涉大川，利君子贞。",
  "yaoci": [
   {
    "name": "初九",
    "text": "同人于门，无咎。"
   },
   {
    "name": "六二",
    "text": "同人于宗，吝。"
   },
   {
    "name": "九三",
    "text": "伏戎于莽，升其高陵，三岁不兴。"
   },
   {
    "name": "九四",
    "text": "乘其墉，弗克攻，吉。"
   },
   {
    "name": "九五",
    "text": "同人，先号咷，而后笑，大师克相遇。"
   },
   {
    "name": "上九",
    "text": "同人于郊，无悔。"
   }
  ]
 },
 {
  "id": 14,
  "name": "大有",
  "symbol": "䷍",
  "array": [
   1,
   1,
   1,
   1,
   0,
   1
  ],
  "lower": "乾",
  "upper": "离",
  "lower_symbol": "☰",
  "upper_symbol": "☲",
  "wuxing": "火",
  "xiantian_upper": 3,
  "xiantian_lower": 1,
  "guaci": "元亨。",
  "yaoci": [
   {
    "name": "初九",
    "text": "无交害，匪咎；艰则无咎。"
   },
   {
    "name": "九二",
    "text": "大车以载，有攸往，无咎。"
   },
   {
    "name": "九三",
    "text": "公用亨于天子，小人弗克。"
   },
   {
    "name": "九四",
    "text": "匪其彭，无咎。"
   },
   {
    "name": "六五",
    "text": "厥孚交如，威如，吉。"
   },
   {
    "name": "上九",
    "text": "自天祐之，吉无不利。"
   }
  ]
 },
 {
  "id": 15,
  "name": "谦",
  "symbol": "䷎",
  "array": [
   0,
   0,
   1,
   0,
   0,
   0
  ],
  "lower": "艮",
  "upper": "坤",
  "lower_symbol": "☶",
  "upper_symbol": "☷",
  "wuxing": "土",
  "xiantian_upper": 8,
  "xiantian_lower": 7,
  "guaci": "亨，君子有终。",
  "yaoci": [
   {
    "name": "初六",
    "text": "谦谦君子，用涉大川，吉。"
   },
   {
    "name": "六二",
    "text": "鸣谦，贞吉。"
   },
   {
    "name": "九三",
    "text": "劳谦，君子有终，吉。"
   },
   {
    "name": "六四",
    "text": "无不利，㧑谦。"
   },
   {
    "name": "六五",
    "text": "不富以其邻，利用侵伐，无不利。"
   },
   {
    "name": "上六",
    "text": "鸣谦，利用行师，征邑国。"
   }
  ]
 },
 {
  "id": 16,
  "name": "豫",
  "symbol": "䷏",
  "array": [
   0,
   0,
   0,
   1,
   0,
   0
  ],
  "lower": "坤",
  "upper": "震",
  "lower_symbol": "☷",
  "upper_symbol": "☳",
  "wuxing": "木",
  "xiantian_upper": 4,
  "xiantian_lower": 8,
  "guaci": "利建侯，行师。",
  "yaoci": [
   {
    "name": "初六",
    "text": "鸣豫，凶。"
   },
   {
    "name": "六二",
    "text": "介于石，不终日，贞吉。"
   },
   {
    "name": "六三",
    "text": "盱豫，悔。迟有悔。"
   },
   {
    "name": "九四",
    "text": "由豫，大有得；勿疑。朋盍簪。"
   },
   {
    "name": "六五",
    "text": "贞疾，恒不死。"
   },
   {
    "name": "上六",
    "text": "冥豫，成有渝，无咎。"
   }
  ]
 },
 {
  "id": 17,
  "name": "随",
  "symbol": "䷐",
  "array": [
   1,
   0,
   0,
   1,
   1,
   0
  ],
  "lower": "震",
  "upper": "兑",
  "lower_symbol": "☳",
  "upper_symbol": "☱",
  "wuxing": "金",
  "xiantian_upper": 2,
  "xiantian_lower": 4,
  "guaci": "元亨，利贞，无咎。",
  "yaoci": [
   {
    "name": "初九",
    "text": "官有渝，贞吉；出门交有功。"
   },
   {
    "name": "六二",
    "text": "系小子，失丈夫。"
   },
   {
    "name": "六三",
    "text": "系丈夫，失小子；随有求得，利居贞。"
   },
   {
    "name": "九四",
    "text": "随有获，贞凶；有孚在道，以明，何咎？"
   },
   {
    "name": "九五",
    "text": "孚于嘉，吉。"
   },
   {
    "name": "上六",
    "text": "拘系之，乃从维之；王用亨于西山。"
   }
  ]
 },
 {
  "id": 18,
  "name": "蛊",
  "symbol": "䷑",
  "array": [
   0,
   1,
   1,
   0,
   0,
   1
  ],
  "lower": "巽",
  "upper": "艮",
  "lower_symbol": "☴",
  "upper_symbol": "☶",
  "wuxing": "土",
  "xiantian_upper": 7,
  "xiantian_lower": 5,
  "guaci": "元亨，利涉大川。先甲三日，后甲三日。",
  "yaoci": [
   {
    "name": "初六",
