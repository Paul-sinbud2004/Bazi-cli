  "xiantian_upper": 4,
  "xiantian_lower": 3,
  "guaci": "亨，王假之；勿忧，宜日中。",
  "yaoci": [
   {
    "name": "初九",
    "text": "遇其配主，虽旬无咎，往有尚。"
   },
   {
    "name": "六二",
    "text": "丰其蔀，日中见斗。往得疑疾，有孚发若，吉。"
   },
   {
    "name": "九三",
    "text": "丰其沛，日中见沬；折其右肱，无咎。"
   },
   {
    "name": "九四",
    "text": "丰其蔀，日中见斗，遇其夷主，吉。"
   },
   {
    "name": "六五",
    "text": "来章，有庆誉，吉。"
   },
   {
    "name": "上六",
    "text": "丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。"
   }
  ]
 },
