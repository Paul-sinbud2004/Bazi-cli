  "upper_symbol": "☲",
  "wuxing": "火",
  "xiantian_upper": 3,
  "xiantian_lower": 2,
  "guaci": "小事吉。",
  "yaoci": [
   {
    "name": "初九",
    "text": "悔亡；丧马勿逐，自复；见恶人，无咎。"
   },
   {
    "name": "九二",
    "text": "遇主于巷，无咎。"
   },
   {
    "name": "六三",
    "text": "见舆曳，其牛掣；其人天且劓。无初有终。"
   },
   {
    "name": "九四",
    "text": "睽孤，遇元夫，交孚，厉无咎。"
   },
   {
    "name": "六五",
    "text": "悔亡，厥宗噬肤，往何咎？"
   },
   {
    "name": "上九",
    "text": "睽孤，见豕负涂，载鬼一车，先张之弧，后说之弧；匪寇婚媾，往遇雨则吉。"
   }
  ]
 },
 {
