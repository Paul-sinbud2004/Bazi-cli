[
 {
  "number": 1,
  "title": "姜公封相",
  "grade": "上上",
  "poem": [
   "灵签求得第一枝",
   "龙虎风云际会时",
   "一旦凌霄扬自乐",
   "任君来往赴瑶池"
  ]
 },
 {
  "number": 2,
  "title": "王道真误入桃源",
  "grade": "上吉",
  "poem": [
   "枮木逢春尽发新",
   "花香叶茂蝶来频",
   "桃源竞鬭千红紫",
   "一片渔舟误入津"
  ]
 },
 {
  "number": 3,
  "title": "鲁班伐木",
  "grade": "中平",
  "poem": [
   "牛山之木皆常美",
   "独惜斧工尽伐他",
   "大器大材无足用",
   "矩规不准怎为槎"
  ]
 },
 {
  "number": 4,
  "title": "燕子教飞",
  "grade": "中吉",
  "poem": [
   "调雏紫燕在簷前",
   "对语呢喃近午天",
   "或往或来低复起",
   "有时剪破绿杨烟"
  ]
 },
 {
  "number": 5,
  "title": "陶渊明栽花",
  "grade": "中吉",
  "poem": [
   "东园昨夜狂风急",
   "万紫千红亦尽倾",
   "幸有惜花人起早",
   "培回根本复栽生"
  ]
 },
 {
  "number": 6,
  "title": "苏东坡游滕王阁",
  "grade": "上吉",
  "poem": [
   "一片孤帆万里回",
   "管弦呕哑且停杯",
   "如云胜友谈风月",
   "畅叙幽情极乐哉"
  ]
 },
 {
  "number": 7,
  "title": "丁山射雁",
  "grade": "中平",
  "poem": [
   "秋来征雁向南归",
   "红叶纷纷满院飞",
   "砧捣城头声切耳",
   "江枫如火在渔矶"
  ]
 },
 {
  "number": 8,
  "title": "鹊巢鸠居",
  "grade": "下下",
  "poem": [
   "鸣鸠争夺鹊巢居",
   "宾主参差意不舒",
   "满岭乔松萝茑附",
   "且猜诗语是何如"
  ]
 },
 {
  "number": 9,
  "title": "陶渊明赏菊",
  "grade": "上吉",
  "poem": [
   "瑶琴一曲奏新腔",
   "明月清风枕簟凉",
   "咸集嘉宾同赏菊",
   "或歌或舞或飞觞"
  ]
 },
 {
  "number": 10,
  "title": "苏秦不第",
  "grade": "中平",
  "poem": [
   "一轮月镜挂空中",
   "偶被浮云障叠重",
   "玉匣何时光气吐",
   "谁人借我一狂风"
  ]
 },
 {
  "number": 11,
  "title": "汉文帝赏柳",
  "grade": "上吉",
  "poem": [
   "杨柳垂隄锁绿烟",
   "日长三起又三眠",
   "往来紫燕纷飞舞",
   "嬝娜迎风倩我怜"
  ]
 },
 {
  "number": 12,
  "title": "蜃楼海市",
  "grade": "下下",
  "poem": [
   "蜃楼海市幻无边",
   "万丈擎空接上天",
   "或被狂风忽吹散",
   "有时仍聚结青烟"
  ]
 },
 {
  "number": 13,
  "title": "孟浩然寻梅",
  "grade": "中平",
  "poem": [
   "岭南初放一枝梅",
   "片片晶萤入酒杯",
   "却遇骑驴人早至",
   "儿童背负占春魁"
  ]
 },
 {
  "number": 14,
  "title": "陶渊明醉酒",
  "grade": "中平",
  "poem": [
   "为爱幽闲多种竹",
   "买春赏雨在茅屋",
   "醉时卧倒杏花边",
   "怕听莺儿惊梦熟"
  ]
 },
 {
  "number": 15,
  "title": "唐明皇游月殿",
  "grade": "上吉",
  "poem": [
   "仙槎一叶泛中流",
   "月殿蟾宫任尔游",
   "盈耳霓裳声暂歇",
   "酒诗吟饮几时休"
  ]
 },
 {
  "number": 16,
  "title": "牧童归家",
  "grade": "中吉",
  "poem": [
   "天边鸦背夕阳回",
   "陇外儿童跨犊来",
   "羗笛频吹声切耳",
   "短长腔调乐何哉"
  ]
 },
 {
  "number": 17,
  "title": "月光圆满",
  "grade": "中平",
  "poem": [
   "秋水兼葭白露盈",
   "盈庭月色浸阶清",
   "清风吹动马铃响",
   "响接晨钟不断声"
  ]
 },
 {
  "number": 18,
  "title": "杜鹃",
  "grade": "下下",
  "poem": [
   "杜鹃啼血泪悲声",
   "声怨霜寒梦乍惊",
   "惊动异乡为异客",
   "客心更触故园情"
  ]
 },
 {
  "number": 19,
  "title": "伏羲画八卦",
  "grade": "中吉",
  "poem": [
   "乾卦三连号太阳",
   "潜龙勿用第一章",
   "其中爻象能参透",
   "百福骈臻大吉昌"
  ]
 },
 {
  "number": 20,
  "title": "天上仙花",
  "grade": "中平",
  "poem": [
   "天上仙花难问种",
   "人间尘事几多更",
   "前程已注公私簿",
   "罚赏分明浊与清"
  ]
 },
 {
  "number": 21,
  "title": "吴稳之会宴",
  "grade": "中吉",
  "poem": [
   "天外红霞如抹锦",
   "槛边桃杏鬭新粧",
   "盈眸烂熳谁居首",
   "美酒频斟且酌量"
  ]
 },
 {
  "number": 22,
  "title": "他乡作客",
  "grade": "下下",
  "poem": [
   "秋水伊人各一方",
   "天南地北恨偏长",
   "相思诗问凭谁寄",
   "不尽凄凉几断肠"
  ]
 },
 {
  "number": 23,
  "title": "梦中得宝",
  "grade": "中平",
  "poem": [
   "邯郸一梦幻无边",
   "数载身荣是熟眠",
   "换却锦衣归故里",
   "睡醒还记在心田"
  ]
 },
 {
  "number": 24,
  "title": "秦琼卖马",
  "grade": "下下",
  "poem": [
   "诗酒琴棋可解愁",
   "座中无客乐难休",
   "或弹或唱谁知美",
   "吟饮须多亦是忧"
  ]
 },
 {
  "number": 25,
  "title": "五岳泰山",
  "grade": "上吉",
  "poem": [
   "群山扰扰朝中岳",
   "有似为臣列鹄班",
   "拱立两行齐整肃",
   "自居此地岂无欢"
  ]
 },
 {
  "number": 26,
  "title": "水月镜花",
  "grade": "中平",
  "poem": [
   "花影迟迟侵砌上",
   "遥知月镜挂长空",
   "忽闻鹤泪声凄切",
   "早买归舟返里中"
  ]
 },
 {
  "number": 27,
  "title": "蚁子知时",
  "grade": "中平",
  "poem": [
   "天晴粉蝶翻衣晒",
   "又看庭前蚁阵排",
   "队伍整齐趋或退",
   "时开时合思何佳"
  ]
 },
 {
  "number": 28,
  "title": "白司马被贬",
  "grade": "中平",
  "poem": [
   "船泊浔阳月夜天",
   "琵琶一曲动人怜",
   "相思两地凭谁寄",
   "白雪催人上鬂巅"
  ]
 },
 {
  "number": 29,
  "title": "王羲之赏菊",
  "grade": "中吉",
  "poem": [
   "鲈鱼作脍菊花黄",
   "美酒盈樽近晚凉",
   "泛棹正当潮上侯",
   "这般佳景乐无央"
  ]
 },
 {
  "number": 30,
  "title": "贵妃受劫",
  "grade": "下下",
  "poem": [
   "倾国倾城媚百生",
   "六宫粉黛尽无名",
   "马嵬山下魂飞去",
   "至今明皇长恨情"
  ]
 },
 {
  "number": 31,
  "title": "渔翁遇风失东西",
  "grade": "下下",
  "poem": [
   "狂风骤雨打船蓬",
   "溪畔桃花尽落红",
   "惊醒渔翁春梦熟",
   "持篙撑去失西东"
  ]
 },
 {
  "number": 32,
  "title": "苏武牧羊",
  "grade": "中平",
  "poem": [
   "十九年前海上辛",
   "节旄雕败逐沙尘",
   "餐毛嚼雪谁怜我",
   "惟有羊儿作伴群"
  ]
 },
 {
  "number": 33,
  "title": "曹操走难",
  "grade": "中平",
  "poem": [
   "曹操虽有深谋计",
   "智慧难暪诸葛侯",
   "试看东风都可借",
   "更能流马木成牛"
  ]
 },
 {
  "number": 34,
  "title": "大舜耕田",
  "grade": "中吉",
  "poem": [
   "大舜虽耕在历山",
   "心常孝顺两嚣顽",
   "田中之象同家象",
   "善恶分明即此间"
  ]
 },
 {
  "number": 35,
  "title": "唐僧取经",
  "grade": "中吉",
  "poem": [
   "天将降任此其人",
   "筋骨先劳苦彼身",
   "莫谓景佳来可易",
   "贫穷富贵有前因"
  ]
 },
 {
  "number": 36,
  "title": "陶渊明归家",
  "grade": "中吉",
  "poem": [
   "此事真如到岸船",
   "何忧风水不相全",
   "举头便见前村落",
   "屋角阳斜爨已烟"
  ]
 },
 {
  "number": 37,
  "title": "王羲之钓鱼",
  "grade": "上吉",
  "poem": [
   "月夜秋江下钓鳌",
   "鱼形恰似四腮鲈",
   "家藏旧酿堪盈斗",
   "与友飞觞尽倒壶"
  ]
 },
 {
  "number": 38,
  "title": "陶渊明辞官归隐",
  "grade": "中吉",
  "poem": [
   "归去来兮仕官闲",
   "室堪容膝亦为安",
   "南窗寄傲谈诗酒",
   "倚杖徘徊饱看山"
  ]
 },
 {
  "number": 39,
  "title": "夷齐让园",
  "grade": "中平",
  "poem": [
   "夷齐不忍食周粟",
   "兄弟心甘采蕨餐",
   "让国名应垂万古",
   "可怜饿倒首阳山"
  ]
 },
 {
  "number": 40,
  "title": "伯牙碎琴",
  "grade": "下下",
  "poem": [
   "人世知音能有几",
   "碎琴都为子期亡",
   "坟前洒尽千行泪",
   "隔别阴阳各一方"
  ]
 },
 {
  "number": 41,
  "title": "张骞遇仙姬",
  "grade": "中吉",
  "poem": [
   "浮槎月夜到天河",
   "曾见仙姬织锦梭",
   "石得支机人罕识",
   "那知此宝出云窝"
  ]
 },
 {
  "number": 42,
  "title": "王允遇貂婵",
  "grade": "中吉",
  "poem": [
   "月明散步到花栏",
   "无策焉能勦灭奸",
   "幸有貂婵思定国",
   "英雄难过美人关"
  ]
 },
 {
  "number": 43,
  "title": "韩文公谏君",
  "grade": "下下",
  "poem": [
   "只因直谏怒天颜",
   "昼夜难离在马鞍",
   "主仆奔忙神亦倦",
   "更加雪重拥蓝关"
  ]
 },
 {
  "number": 44,
  "title": "唐天宝赏牡丹",
  "grade": "中吉",
  "poem": [
   "满园春色𫔯新粧",
   "意似争妍夺国香",
   "到底是谁君丽首",
   "牡丹艳冠百花场"
  ]
 },
 {
  "number": 45,
  "title": "王质遇仙",
  "grade": "中平",
  "poem": [
   "采樵不意到云巅",
   "闲看敲棋二老仙",
   "柯烂也思归故里",
   "山中七日世千年"
  ]
 },
 {
  "number": 46,
  "title": "左慈戏曹",
  "grade": "下下",
  "poem": [
   "黄柑数盒献曹公",
   "剖看原来肉尽空",
   "怒动奸雄挥铁斧",
   "奔忙身入万羊中"
  ]
 },
 {
  "number": 47,
  "title": "鲁肃取荆州",
  "grade": "中平",
  "poem": [
   "遥遥千里来西蜀",
   "欲问荆州那日还",
   "刘备不言声泪下",
   "自思无策转吴间"
  ]
 },
 {
  "number": 48,
  "title": "文君卖酒",
  "grade": "中平",
  "poem": [
   "绣阁听琴自起思",
   "改粧寅夜最欢时",
   "可怜沽酒临邛市",
   "才子佳人两下厨"
  ]
 },
 {
  "number": 49,
  "title": "司马相如题桥",
  "grade": "中吉",
  "poem": [
   "十年窗下苦功成",
   "有志难舒愿不轻",
   "试看题桥十三字",
   "生平心誓确钟情"
  ]
 },
 {
  "number": 50,
  "title": "伍子胥出关",
  "grade": "中吉",
  "poem": [
   "记得当年伍子胥",
   "潜奔难渡幸逢渔",
   "欲将宝剑相持赠",
   "大义交朋却也辞"
  ]
 },
 {
  "number": 51,
  "title": "周成王封弟",
  "grade": "中平",
  "poem": [
   "剪桐虽是作儿嬉",
   "封弟成圭语不移",
   "何以伪为成实事",
   "言因无戏故如斯"
  ]
 },
 {
  "number": 52,
  "title": "天地人三才",
  "grade": "中平",
  "poem": [
   "上清下浊成天地",
   "清浊相凝便作人",
   "尔欲签求明白事",
   "且将三等细明分"
  ]
 },
 {
  "number": 53,
  "title": "孟尝君",
  "grade": "中吉",
  "poem": [
   "珠履三千客孟尝",
   "谁人识得有膺扬",
   "其中弹铗归来者",
   "便是英雄志莫当"
  ]
 },
 {
  "number": 54,
  "title": "庄周蝶梦",
  "grade": "中平",
  "poem": [
   "庄周酣眠成蝶梦",
   "翩翩飞入百花丛",
   "天香探得归来后",
   "犹在高床暖枕中"
  ]
 },
 {
  "number": 55,
  "title": "吴隐之除官归隐",
  "grade": "中平",
  "poem": [
   "浦号沉香遗旧恨",
   "渡江犹忆古人心",
   "可怜当日辞官去",
   "虽有馨留不易寻"
  ]
 },
 {
  "number": 56,
  "title": "桃木剑化龙",
  "grade": "中吉",
  "poem": [
   "安知此剑不成龙",
   "见水都应出袖中",
   "他日飞腾千万里",
   "上空妖矫有云从"
  ]
 },
 {
  "number": 57,
  "title": "卖花得美",
  "grade": "中吉",
  "poem": [
   "小楼春雨声初歇",
   "彳亍街头屐不停",
   "忽听卖花人入巷",
   "一枝买得慢行行"
  ]
 },
 {
  "number": 58,
  "title": "秦穆公大败",
  "grade": "下下",
  "poem": [
   "秦师大败在殽山",
   "三帅皆擒尽放还",
   "蹇叔谏言因不听",
   "倒戈舍甲返秦间"
  ]
 },
 {
  "number": 59,
  "title": "吴王宠西施",
  "grade": "下下",
  "poem": [
   "澣溪纱女美无双",
   "媚至吴王国破亡",
   "最恼东施效颦笑",
   "山鸡岂可胜鸾凰"
  ]
 },
 {
  "number": 60,
  "title": "太白和番",
  "grade": "中平",
  "poem": [
   "和番醉笔似云烟",
   "日在长安酒店眠",
   "倘遇唐王颁令召",
   "重呼不上木兰船"
  ]
 },
 {
  "number": 61,
  "title": "岳飞受劫",
  "grade": "下下",
  "poem": [
   "十二金牌速召回",
   "奸雄设计几时灵",
   "可怜一旦功劳散",
   "老少扶车不断哀"
  ]
 },
 {
  "number": 62,
  "title": "美玉藏金",
  "grade": "中平",
  "poem": [
   "美玉于斯韫匮藏",
   "休求善价费商量",
   "沽之亦可随相待",
   "此物何须自看常"
  ]
 },
 {
  "number": 63,
  "title": "颜回守道",
  "grade": "中吉",
  "poem": [
   "陋巷箪瓢不足愁",
   "傍人见此甚为忧",
   "不知乐道忘贫之",
   "亚圣芳名万古留"
  ]
 },
 {
  "number": 64,
  "title": "孟之反奔",
  "grade": "中吉",
  "poem": [
   "奔殿须知上古人",
   "入门策马不夸能",
   "败师谁肯甘从后",
   "托谓鸣骢畏苦辛"
  ]
 },
 {
  "number": 65,
  "title": "陈后主失位",
  "grade": "下下",
  "poem": [
   "隋灭陈时战伐纷",
   "都因妖媚闭明君",
   "陈奔西赴无藏息",
   "井里胭脂隐玉人"
  ]
 },
 {
  "number": 66,
  "title": "王羲之会群贤",
  "grade": "上吉",
  "poem": [
   "兰亭雅会众群贤",
   "曲水流觞舍管弦",
   "天朗气清风惠畅",
   "茂林修竹乐怡然"
  ]
 },
 {
  "number": 67,
  "title": "霸王自缢",
  "grade": "中平",
  "poem": [
   "人虽勇力不能当",
   "莫恃英雄独冠场",
   "可挟泰山超北海",
   "身心犹贵重存亡"
  ]
 },
 {
  "number": 68,
  "title": "姜太公遇文王",
  "grade": "中吉",
  "poem": [
   "久抱凌云志未舒",
   "荷竿渭水钓游鱼",
   "文王千里求贤士",
   "灭纣兴周任意如"
  ]
 },
 {
  "number": 69,
  "title": "韩文公祭鳄鱼",
  "grade": "中吉",
  "poem": [
   "忠义存心官十载",
   "年丰民乐惠难忘",
   "鳄鱼毒害都能息",
   "祷告长江北海王"
  ]
 },
 {
  "number": 70,
  "title": "塞翁失马",
  "grade": "中平",
  "poem": [
   "可比当年一塞翁",
   "虽然失马半途中",
   "不知祸福真何是",
   "到底方明事始终"
  ]
 },
 {
  "number": 71,
  "title": "庄周活鲋鱼",
  "grade": "中平",
  "poem": [
   "涸辙之中鲋困之",
   "穷通自可卜当时",
   "若能引得西江水",
   "他日成龙也未知"
  ]
 },
 {
  "number": 72,
  "title": "守株待兔",
  "grade": "中平",
  "poem": [
   "兔儿久待意何如",
   "堪叹愚人独守株",
   "算是无能令我笑",
   "不须守旧自拘拘"
  ]
 },
 {
  "number": 73,
  "title": "伦文叙高中",
  "grade": "上上",
  "poem": [
   "夹道花香衬马蹄",
   "蓝袍改换锦衣归",
   "满街红粉皆争羡",
   "翘首芳名雁塔题"
  ]
 },
 {
  "number": 74,
  "title": "朱买臣分妻",
  "grade": "下下",
  "poem": [
   "回忆当年运蹇时",
   "夫妻反目两分离",
   "名题雁塔归来候",
   "覆水马头时否悲"
  ]
 },
 {
  "number": 75,
  "title": "伦文叙分妻",
  "grade": "下下",
  "poem": [
   "婚姻岂可厌家贫",
   "文叙夫妻两拆分",
   "一旦首登龙虎榜",
   "戏妻楼坠自亡身"
  ]
 },
 {
  "number": 76,
  "title": "孔夫子守道",
  "grade": "中平",
  "poem": [
   "人能乐道自修身",
   "疏水曲肱岂厌贫",
   "不义而富且贵者",
   "我心都是作浮云"
  ]
 },
 {
  "number": 77,
  "title": "公冶长受劫",
  "grade": "中平",
  "poem": [
   "鸟语能通公冶长",
   "南山得个虎抬羊",
   "其身虽在于缧絏",
   "到底非关自己殃"
  ]
 },
 {
  "number": 78,
  "title": "曾点言志",
  "grade": "上吉",
  "poem": [
   "瑟希铿尔尚留声",
   "春暮时刚春服成",
   "冠五六人童六七",
   "舞雩归咏畅幽情"
  ]
 },
 {
  "number": 79,
  "title": "苏秦封相",
  "grade": "中平",
  "poem": [
   "富贵有如春梦熟",
   "世人何苦力争求",
   "任他秉笏当朝立",
   "到死惟留土一坏"
  ]
 },
 {
  "number": 80,
  "title": "杯中弓映",
  "grade": "中吉",
  "poem": [
   "飞觞对舞几时赊",
   "弓影横杯悮食蛇",
   "猜透诗中元妙诀",
   "泰来否极事无差"
  ]
 },
 {
  "number": 81,
  "title": "子路射雌",
  "grade": "中吉",
  "poem": [
   "山梁雌雉得其时",
   "上下飞鸣自乐之",
   "色举须知翔后集",
   "作声三嗅过山欹"
  ]
 },
 {
  "number": 82,
  "title": "孔子在卫",
  "grade": "中平",
  "poem": [
   "圣人击磬在于卫",
   "谁料过门有荷篑",
   "嗟叹有心挽道穷",
   "可怜日月今将逝"
  ]
 },
 {
  "number": 83,
  "title": "人心不足",
  "grade": "中平",
  "poem": [
   "凡麈身历几时闲",
   "世事浑如叠叠山",
   "既富尚忧无贵子",
   "不知花放又花残"
  ]
 },
 {
  "number": 84,
  "title": "韩信投军",
  "grade": "中吉",
  "poem": [
   "满腹奇才志未冲",
   "鉄鸡难举意无容",
   "张良指示身投汉",
   "项羽乌江命自穷"
  ]
 },
 {
  "number": 85,
  "title": "刘向高中",
  "grade": "上吉",
  "poem": [
   "太乙燃藜照读书",
   "十年窗下苦功舒",
   "扬眉吐气袍穿锦",
   "驷马高车拥道随"
  ]
 },
 {
  "number": 86,
  "title": "陶侃母留名万载",
  "grade": "中吉",
  "poem": [
   "截发迎宾否也贫",
   "贫中贤妇更何人",
   "古今只有陶侃母",
   "所以名留万代闻"
  ]
 },
 {
  "number": 87,
  "title": "两雄相遇",
  "grade": "中平",
  "poem": [
   "会谈华座逞英雄",
   "究竟谁人秉大公",
   "一云日下荀鸣鹤",
   "一说云间陆士龙"
  ]
 },
 {
  "number": 88,
  "title": "木兰从军",
  "grade": "中吉",
  "poem": [
   "替父从军胆气雄",
   "须眉巾帼几人同",
   "以身报国忠而孝",
   "笑煞当时众巨公"
  ]
 },
 {
  "number": 89,
  "title": "吴季子挂剑",
  "grade": "下下",
  "poem": [
   "他邦远历佩鱼肠",
   "谁料徐君意欲将",
   "既返愿为相赠答",
   "且悬树下表情长"
  ]
 },
 {
  "number": 90,
  "title": "红拂女私奔",
  "grade": "中平",
  "poem": [
   "细整残粧夜欲奔",
   "座中李靖更何人",
   "那知虬髯情钟处",
   "拔剑三回未敢陈"
  ]
 },
 {
  "number": 91,
  "title": "蔡中兴高中",
  "grade": "上上",
  "poem": [
   "蟾官月殿桂飘香",
   "玉箧团圆万里光",
   "六水三山归镜里",
   "无瑕一片挂穹苍"
  ]
 },
 {
  "number": 92,
  "title": "孔夫子周游列国",
  "grade": "中吉",
  "poem": [
   "至圣周游列国行",
   "在齐得听奏韶声",
   "三月不知嘉肉味",
   "善哉大道可功成"
  ]
 },
 {
  "number": 93,
  "title": "郑王失位",
  "grade": "下下",
  "poem": [
   "郑卫之音不忍听",
   "淫风败俗国将倾",
   "令人深入迷津路",
   "所奏全非古乐声"
  ]
 },
 {
  "number": 94,
  "title": "两虎相争",
  "grade": "中平",
  "poem": [
   "一窟难藏两虎儿",
   "乘风别岭各栖之",
   "名山自守为巢穴",
   "可免伤残后悔迟"
  ]
 },
 {
  "number": 95,
  "title": "女娲氏",
  "grade": "中平",
  "poem": [
   "功勤一篑可成山",
   "由少而多莫惮烦",
   "作事畏辛今汝画",
   "补天炼石亦无难"
  ]
 },
 {
  "number": 96,
  "title": "文姬思汉",
  "grade": "中平",
  "poem": [
   "姜笛频吹韵更悲",
   "异乡作客触归期",
   "南来孤雁如怜我",
   "烦寄家书转达知"
  ]
 },
 {
  "number": 97,
  "title": "康顺钓鱼",
  "grade": "中平",
  "poem": [
   "凭栏晚眺倚南楼",
   "满目风光景色幽",
   "一叶小舟频下饵",
   "渔翁钓得有鱼无"
  ]
 },
 {
  "number": 98,
  "title": "掘地寻金",
  "grade": "中平",
  "poem": [
   "入山种玉嫌田狭",
   "掘地寻金厌客多",
   "富贵贫穷天注定",
   "世人何苦力奔波"
  ]
 },
 {
  "number": 99,
  "title": "韩文公遇雪",
  "grade": "中平",
  "poem": [
   "雪拥桥头马不前",
   "风狂渔父莫开船",
   "水流花谢人谁惜",
   "早立坚心志勿偏"
  ]
 },
 {
  "number": 100,
  "title": "百花开放",
  "grade": "中吉",
  "poem": [
   "百花竞放贺阳春",
   "万物从今尽转新",
   "末数莫言穷运至",
   "不知否极泰来频"
  ]
 }
]